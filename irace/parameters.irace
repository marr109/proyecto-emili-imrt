# irace parameter space of the BAO algorithms. Mirrors grammars/imrt_bao.xml.
# The target runner turns the parameters into the EMILI command line.

algorithm      "--algorithm "     c  (ls, ils, sa, vnd, tabu, vns)

# neighbourhood step shared by ls, ils, sa, tabu and the single-neighbourhood VNS local search
step           "--step "          c  (5, 10)
strategy       "--strategy "      c  (first, best)                 | algorithm %in% c("ls", "ils", "tabu")
scan_order     "--scan_order "    c  (fixed, circular, randorder)  | strategy == "first" & algorithm %in% c("ls", "ils")

# perturbation (ils, and vns with a perturbation shake)
pert           "--pert "          c  (shift, adaptive, mag, adaptivemag)  | algorithm == "ils" | (algorithm == "vns" & shake == "pershake")
pert_angles    "--pert_angles "   i  (1, 3)                        | pert == "shift"
mag_angles     "--mag_angles "    i  (1, 2)                        | pert %in% c("adaptive", "mag", "adaptivemag")
stagnation     "--stagnation "    i  (1, 6)                        | pert %in% c("adaptive", "adaptivemag")
stepwise       "--stepwise "      c  (no, yes)                     | pert %in% c("mag", "adaptivemag")

# simulated annealing
sa_kind        "--sa_kind "       c  (metropolis, geometric)       | algorithm == "sa"
t_start        "--t_start "       r  (100.0, 5000.0)               | algorithm == "sa"
t_end          "--t_end "         r  (1.0, 500.0)                  | algorithm == "sa"
beta           "--beta "          r  (1.0, 40.0)                   | sa_kind == "metropolis"
alpha          "--alpha "         r  (0.90, 0.999)                 | sa_kind == "geometric"

# tabu search (tabubao)
tenure_min     "--tenure_min "    i  (1, 10)                       | algorithm == "tabu"
tenure_max     "--tenure_max "    i  (11, 60)                      | algorithm == "tabu"

# VND neighbourhood list (vnd, and vns whose local search is a VND): 2 or 3 ordered neighbourhoods
vns_search     "--vns_search "    c  (shift, vnd)                  | algorithm == "vns"
nb1            "--nb1 "           c  (shift10, shift5, sample, window, flip)  | algorithm == "vnd" | vns_search == "vnd"
nb2            "--nb2 "           c  (shift10, shift5, sample, window, flip)  | algorithm == "vnd" | vns_search == "vnd"
nb3            "--nb3 "           c  (none, shift10, shift5, sample, window, flip)  | algorithm == "vnd" | vns_search == "vnd"
sample_size    "--sample_size "   i  (2, 40)                       | nb1 == "sample" | nb2 == "sample" | nb3 == "sample"
window_deg     "--window_deg "    i  (2, 12)                       | nb1 == "window" | nb2 == "window" | nb3 == "window"

# general VNS shake
shake          "--shake "         c  (bangshake, pershake)         | algorithm == "vns"
shake_levels   "--shake_levels "  i  (1, 4)                        | shake == "bangshake"

[forbidden]
t_start <= t_end
nb1 == nb2
