<?xml version="1.0" encoding="UTF-8" ?>
<gr:grammar xmlns:gr="grammar">
  <gr:derivations xmlns:bao="bao">

    <!--                  ### PARAMETROS NUMERICOS ###                            -->

    <!-- cantidad de ángulos que mueve la perturbación prangshift (1 a 3). -->
    <bao:pert_angles type="int" min="1" max="3" stepIfEnumerated="1"/>

    <!-- máximo de ángulos que mueven las perturbaciones adaptativas y las de magnitud (1 a 2). -->
    <bao:mag_angles type="int" min="1" max="2" stepIfEnumerated="1"/>

    <!-- rondas seguidas sin mejora antes de que una perturbación adaptativa suba de nivel (1 a 6). -->
    <bao:stagnation type="int" min="1" max="6" stepIfEnumerated="1"/>

    <!-- niveles de la sacudida multiescala bangshake (1 a 3).-->
    <bao:shake_levels type="int" min="1" max="3" stepIfEnumerated="1"/>

    <!-- cantidad de vecinos que se sortean en nangswapsample y candidatos que evalúa pgreedysample (2 a 40). -->
    <bao:sample_size type="int" min="2" max="40" stepIfEnumerated="1"/>

    <!-- tamaño en grados de la ventana de nangswapwindow (10 a 60, de a 5). -->
    <bao:window_deg type="int" min="10" max="60" stepIfEnumerated="5"/>

    <!-- límites de la tenencia adaptativa del tabú (1 a 10 y 11 a 60). -->
    <bao:tenure_min type="int" min="1" max="10" stepIfEnumerated="1"/>
    <bao:tenure_max type="int" min="11" max="60" stepIfEnumerated="1"/>

    <!-- tenencia fija de las memorias TBao_fixed y TBao_attr (1 a 60). -->
    <bao:tabu_tenure type="int" min="1" max="60" stepIfEnumerated="1"/>
    
    <!-- ángulos que destruyen las perturbaciones pgreedy y pgreedysample (1 a 3). -->     
    <bao:greedy_d type="int" min="1" max="3" stepIfEnumerated="1"/>

    <!-- t_start y t_end: temperatura inicial y final del SA-->
    <bao:t_start type="real" min="100.0" max="5000.0" stepIfEnumerated="10.0"/>
    <bao:t_end type="real" min="1.0" max="500.0" stepIfEnumerated="1.0"/>

    <!-- razón de enfriamiento de sa_metropolis (en el analizador de EMILI se llama "ratio") (1 a 40). -->
    <bao:beta type="real" min="1.0" max="40.0" stepIfEnumerated="0.5"/>

    <!-- factor de enfriamiento geométrico de saacc (0,90 a 0,999). -->
    <bao:alpha type="real" min="0.90" max="0.999" stepIfEnumerated="0.001"/>

    <!--  ################################################################### -->

    <!-- COMPONENTES COMUNES -->

    <!-- desplazamientos de ángulos disponibles para el vecindario -->
    <bao:step>
      <![CDATA[1]]>
      <or/>
      <![CDATA[5]]>
      <or/>
      <![CDATA[10]]>
      <or/>
      <![CDATA[20]]>
    </bao:step>

    <!-- generación de soluciones iniciales, en estos se encuentra:

      1. irandomk: generación aleatoria de k ángulos, con restrición de que sean múltiplos de 5 (puede tomar solo 72 ángulos).
      2. irandomk unrestricted: k ángulos aleatorios, sin restricción de que sean múltiplos de 5 (puede tomar los 360 ángulos).
    -->
    <bao:init>
      <![CDATA[irandomk]]>
      <or/>
      <![CDATA[irandomk unrestricted]]>
    </bao:init>

    <!-- Estrategias de aceptación de soluciones, en estos se encuentra:

      1. first: se acepta la primera solución que mejore a la actual.
      2. best: se aceptan todas las soluciones que mejoren a la actual, y se escoge la mejor de ellas. 
    -->
    <bao:strategy>
      <![CDATA[first]]>
      <or/>
      <![CDATA[best]]>
    </bao:strategy>

    <!-- ordenes de escaneo, para esto existe:
      1. fixed: Orden de escaneo fijo, al momento de mejorar la solucion, se vuelve a escanear en el mismo orden (izquierda a derecha)
      2. circular: Orden de escaneo circular, al momento de mejorar la solucion se inicia desde el siguiente angulo al que se mejoro.
      3. randorder: Orden de escaneo aleatorio, al momento de mejorar la solucion se vuelve a escanear en un orden aleatorio.  
    -->
    <bao:scan_order>
      <![CDATA[fixed]]>
      <or/>
      <![CDATA[circular]]>
      <or/>
      <![CDATA[randorder]]>
    </bao:scan_order>

    <!-- modificación del ángulo de desplazamiento, reemplaza según el tamaño del vecindario -->
    <bao:shift_step>
      <![CDATA[nangshift ]]><bao:step/>
    </bao:shift_step>

    <!-- Tipo de vecindario, en estos se encuentra:
      1. nangshift: desplazamiento de ángulos según el step (-+ value).
      2. nangswapsample: intercambio de ángulos muestrales.
      3. nangswapwindow: intercambio de ángulos en una ventana.
      4. nangflip: volteo de ángulos.
    -->
    <bao:neighbourhood>
      <![CDATA[nangshift 20]]>
      <or/>
      <![CDATA[nangshift 10]]>
      <or/>
      <![CDATA[nangshift 5]]>
      <or/>
      <![CDATA[nangshift 1]]>
      <or/>
      <![CDATA[nangswapsample ]]><bao:sample_size/>
      <or/>
      <![CDATA[nangswapwindow ]]><bao:window_deg/>
      <or/>
      <![CDATA[nangflip 0]]>
    </bao:neighbourhood>

    <!-- Lista ordenada de vecindarios para el VND y para la búsqueda local del VNS, en estas se encuentra:

      1. dos vecindarios.
      2. tres vecindarios.

      Se recorren en orden: si ninguno de los vecinos del vecindario actual mejora, se pasa al siguiente; si alguno mejora, se
      vuelve al primero.
    -->
    <bao:neighbourhood_list>
      <bao:neighbourhood/><![CDATA[ ]]><bao:neighbourhood/>
      <or/>
      <bao:neighbourhood/><![CDATA[ ]]><bao:neighbourhood/><![CDATA[ ]]><bao:neighbourhood/>
    </bao:neighbourhood_list>

    <!-- Evaluación dentro de la perturbación, en estos se encuentra:

      1. (vacío): se evalúa el FMO una sola vez, al final de la perturbación.
      2. stepwise: se evalúa el FMO después de cada movimiento individual de la perturbación (más resoluciones del FMO).
    -->
    <!-- el CDATA lleva un espacio a propósito: grammar2code elimina los CDATA vacíos y, con ellos, la alternativa "sin stepwise" -->
    <bao:stepwise>
      <![CDATA[ ]]>
      <or/>
      <![CDATA[ stepwise]]>
    </bao:stepwise>

    <!-- Selección de los ángulos que mueve una perturbación de desplazamiento, en estos se encuentra:

      1. distinct: los ángulos movidos son todos distintos (sin reemplazo); es el comportamiento por defecto.
      2. replace: el ángulo de cada movimiento se sortea por separado (con reemplazo), así que un mismo ángulo puede moverse
         más de una vez y el segundo movimiento parte de su posición nueva.
    -->
    <bao:replacement>
      <![CDATA[distinct]]>
      <or/>
      <![CDATA[replace]]>
    </bao:replacement>

    <!-- Tipo de perturbación, en estos se encuentra:

      Observación: Las variantes con magnitud mueven como máximo 2 ángulos.
    -->
    <bao:perturbation>
       <!-- Desplaza n ángulos una magnitud aleatoria entre step y 2·step (nunca exactamente step). -->
      <![CDATA[prangshift ]]><bao:step/><![CDATA[ ]]><bao:pert_angles/><![CDATA[ ]]><bao:replacement/>
      <or/>
      <!-- Funciona  igual a prangshift parte moviendo 1 ángulo y sube de a uno cada vez que hay "stagnation" rondas sin mejora, hasta un máximo; vuelve a 1 apenas hay una mejora. -->
      <![CDATA[prangshiftadaptive ]]><bao:step/><![CDATA[ ]]><bao:mag_angles/><![CDATA[ ]]><bao:stagnation/><![CDATA[ ]]><bao:replacement/>
      <or/>
      <!-- Mueve n ángulos ±5° o ±10° (signo aleatorio). El texto " 2 5 10" significa "2 magnitudes: 5 y 10". -->
      <![CDATA[prangshiftmag ]]><bao:mag_angles/><![CDATA[ 2 5 10]]><bao:stepwise/><![CDATA[ ]]><bao:replacement/>
      <or/>
      <!-- Versión adaptativa de prangshiftmag -->
      <![CDATA[prangshiftadaptivemag ]]><bao:mag_angles/><![CDATA[ ]]><bao:stagnation/><![CDATA[ 2 5 10]]><bao:stepwise/><![CDATA[ ]]><bao:replacement/>
      <or/>
      <!-- destruye D ángulos y reconstruye cada hueco eligiendo el mejor candidato evaluado.-->
      <![CDATA[pgreedy ]]><bao:greedy_d/>
      <or/>
      <!--  Versión similar a pgreedy, pero evaluando solo una muestra de candidatos por hueco. -->
      <![CDATA[pgreedysample ]]><bao:greedy_d/><![CDATA[ ]]><bao:sample_size/>
    </bao:perturbation>

    <!-- ALGORITMOS -->

    <!-- Búsqueda local hasta el óptimo local (locmin), en estas se encuentra:

      1. first: acepta el primer vecino que mejora; admite orden de escaneo (scan_order).
      2. best: evalúa todos los vecinos y se mueve al mejor; no lleva orden de escaneo porque con best el orden no cambia el resultado.
    -->
    <bao:local_search>
      <![CDATA[first ]]><bao:init/><![CDATA[ locmin ]]><bao:shift_step/><![CDATA[ ]]><bao:scan_order/>
      <or/>
      <![CDATA[best ]]><bao:init/><![CDATA[ locmin ]]><bao:shift_step/>
    </bao:local_search>

    <!-- Búsqueda local iterada: búsqueda local hasta el óptimo local, perturbación y vuelta a empezar. Opciones fijas:

      1. tmaxiter 1000000: tope de iteraciones que en la práctica no se alcanza; el tiempo lo corta la opción -it.
      2. baoimprove: acepta la nueva solución solo si mejora a la actual.
      3. rejectrepeated: rechaza soluciones ya visitadas.
    -->
    <bao:ils>
      <![CDATA[ils first ]]><bao:init/><![CDATA[ locmin ]]><bao:shift_step/><![CDATA[ ]]><bao:scan_order/><![CDATA[ tmaxiter 1000000 ]]><bao:perturbation/><![CDATA[ baoimprove rejectrepeated]]>
      <or/>
      <![CDATA[ils best ]]><bao:init/><![CDATA[ locmin ]]><bao:shift_step/><![CDATA[ tmaxiter 1000000 ]]><bao:perturbation/><![CDATA[ baoimprove rejectrepeated]]>
    </bao:ils>

    <!-- Recocido simulado (no usa búsqueda local ni estrategia), en estos se encuentra:

      1. sa_metropolis: criterio de Metropolis con temperatura inicial, temperatura final y razón de enfriamiento (beta).
      2. saacc: enfriamiento geométrico con temperatura inicial, temperatura final y factor alpha. Los "0 1" son dos argumentos
         fijos del token: la razón de enfriamiento (0) y la frecuencia de enfriamiento en iteraciones (1).
    -->
    <bao:sa>
      <![CDATA[sa ]]><bao:init/><![CDATA[ tmaxiter 1000000 ]]><bao:shift_step/><![CDATA[ sa_metropolis ]]><bao:t_start/><![CDATA[ ]]><bao:t_end/><![CDATA[ ]]><bao:beta/>
      <or/>
      <![CDATA[sa ]]><bao:init/><![CDATA[ tmaxiter 1000000 ]]><bao:shift_step/><![CDATA[ saacc ]]><bao:t_start/><![CDATA[ ]]><bao:t_end/><![CDATA[ 0 1 ]]><bao:alpha/>
    </bao:sa>

    <!-- Descenso de vecindario variable: búsqueda local first hasta el óptimo local sobre una lista de 2 o 3 vecindarios. -->
    <bao:vnd>
      <![CDATA[vnd first ]]><bao:init/><![CDATA[ locmin ]]><bao:neighbourhood_list/>
    </bao:vnd>

    <!-- Memoria de la búsqueda tabú (qué queda prohibido), en estas se encuentra:

      1. TBao_adaptive: prohíbe volver a conjuntos completos de ángulos ya visitados; la tenencia parte en el punto medio entre
         el mínimo y el máximo, sube cuando se revisita una solución y baja tras un período sin revisitas.
      2. TBao_fixed: lo mismo, con una tenencia fija.
      3. TBao_attr: prohíbe volver a poner cualquiera de los últimos t ángulos que salieron del plan, aunque el resto del plan
         sea distinto (memoria por atributo).
    -->
    <bao:tabu_memory>
      <![CDATA[TBao_adaptive ]]><bao:tenure_min/><![CDATA[ ]]><bao:tenure_max/>
      <or/>
      <![CDATA[TBao_fixed ]]><bao:tabu_tenure/>
      <or/>
      <![CDATA[TBao_attr ]]><bao:tabu_tenure/>
    </bao:tabu_memory>

    <!-- Búsqueda tabú propia del proyecto (tabubao): genera los vecinos desde la solución actual y se mueve al mejor vecino admisible
         aunque empeore. La estrategia puede ser first o best, y se detiene tras 100 iteraciones sin una resolución nueva del FMO. -->
    <bao:tabu>
      <![CDATA[tabubao ]]><bao:strategy/><![CDATA[ ]]><bao:init/><![CDATA[ tmaxiter 1000000 ]]><bao:shift_step/><![CDATA[ ]]><bao:tabu_memory/>
    </bao:tabu>

    <!-- Búsqueda local interna del VNS general, en estas se encuentra:

      1. un solo vecindario de desplazamiento.
      2. un VND con una lista de vecindarios.
    -->
    <bao:vns_search>
      <![CDATA[first ]]><bao:init/><![CDATA[ locmin ]]><bao:shift_step/>
      <or/>
      <![CDATA[vnd first ]]><bao:init/><![CDATA[ locmin ]]><bao:neighbourhood_list/>
    </bao:vns_search>

    <!-- Sacudida del VNS general, en estas se encuentra:

      1. bangshake: sacudida multiescala; el nivel 0 reemplaza 1 ángulo por otro al azar y cada nivel siguiente uno más.
      2. pershake: usa una perturbación (cualquiera de las de arriba) como sacudida.
    -->
    <bao:vns_shake>
      <![CDATA[bangshake ]]><bao:shake_levels/>
      <or/>
      <![CDATA[pershake ]]><bao:perturbation/>
    </bao:vns_shake>

    <!-- Búsqueda de vecindario variable general. accng es el criterio de cambio de nivel de la sacudida, y baoimprove y rejectrepeated
         son los mismos de la búsqueda local iterada. -->
    <bao:vns>
      <![CDATA[vns ]]><bao:vns_search/><![CDATA[ tmaxiter 1000000 ]]><bao:vns_shake/><![CDATA[ accng baoimprove rejectrepeated]]>
    </bao:vns>

    <!-- Algoritmo, en estos se encuentra: búsqueda local, ILS, recocido simulado, VND, búsqueda tabú y VNS general. -->
    <bao:algorithm>
      <bao:local_search/>
      <or/>
      <bao:ils/>
      <or/>
      <bao:sa/>
      <or/>
      <bao:vnd/>
      <or/>
      <bao:tabu/>
      <or/>
      <bao:vns/>
    </bao:algorithm>

    <!-- SALIDA FINAL PARA grammar2code: punto de partida de la derivación. Parte de un texto vacío y expande algorithm; el
         llamador antepone la instancia y el problema, y agrega -it y rnds al final. El atributo output="params" es el nombre
         del archivo donde grammar2code escribe la línea de comandos. Con esta gramática, grammar2code genera el espacio de
         parámetros de irace (scripts/grammar2code_irace.py) y traduce cada configuración (irace/target-runner-g2c). -->
    <bao:main_algorithm output="params">
      <![CDATA[]]>
      <bao:algorithm/>
    </bao:main_algorithm>

  </gr:derivations>
</gr:grammar>
